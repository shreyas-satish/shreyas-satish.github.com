---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/" | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ "/podcasts/" | absolute_url }}</loc>
  </url>
  {% assign sitemap_documents = site.posts | concat: site.podcasts %}
  {% for document in sitemap_documents %}
    {% unless document.sitemap == false %}
  <url>
    <loc>{{ document.url | absolute_url }}</loc>
  </url>
    {% endunless %}
  {% endfor %}
</urlset>
